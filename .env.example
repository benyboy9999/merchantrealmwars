# ============================================================
# Merchant Realms — Environment Variables
# Copy this file to .env.dev for local development.
# Never commit .env, .env.staging, or .env.production.
# ============================================================

# --- Server ---
NODE_ENV=development          # development | production
PORT=3000                     # HTTP server port
HOST=0.0.0.0

# --- Database ---
DATABASE_URL=postgresql://merchant_realms:merchant_realms@localhost:5432/merchant_realms_dev

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Game ---
TICK_INTERVAL_SECONDS=10      # 10 for concept, 30 for dev, 300 for prod (5 minutes)
ENABLE_DEBUG_ENDPOINTS=true   # true for dev only — exposes /debug/* routes
ADMIN_TOKEN=change-me         # used by /admin/* endpoints

# --- Client (Vite — must be prefixed VITE_) ---
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
