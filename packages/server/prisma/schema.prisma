generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum WarehouseType {
  KEEP
  CARAVAN
  EXCHANGE
}

enum CaravanStatus {
  IDLE
  IN_TRANSIT
}

enum CaravanLocationType {
  KEEP
  EXCHANGE
  PLOT
}

enum WorkerTier {
  T1
  T2
  T3
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum ProductionOrderType {
  INFINITE
  NUMERICAL
}

enum GuildRole {
  LEADER
  OFFICER
  MEMBER
}

enum ChatChannelType {
  GLOBAL
  GUILD
  REGION
}

// ── Auth ───────────────────────────────────────────────────────────────────

model Player {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  empire        Empire?
  refreshTokens RefreshToken[]
  guildMember   GuildMember?
  chatMessages  ChatMessage[]
  ledsGuilds    Guild[]        @relation("GuildLeader")
}

model RefreshToken {
  id        String   @id @default(cuid())
  playerId  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ── World ──────────────────────────────────────────────────────────────────

model Region {
  id                String  @id
  name              String
  guildControllable Boolean

  districts      District[]
  marketOrders   MarketOrder[]
  taxCollections TaxCollection[]
}

model District {
  id               String @id
  regionId         String
  name             String
  bonusDescription String
  tier             Int    @default(1)
  q                Int
  r                Int
  x                Float
  y                Float

  region           Region            @relation(fields: [regionId], references: [id])
  plots            Plot[]
  districtControls DistrictControl[]

  @@unique([q, r])
  @@index([regionId])
}

model Plot {
  id               String  @id
  districtId       String
  name             String
  bonusDescription String
  tier             Int     @default(1)
  isCenter         Boolean @default(false)
  x                Float
  y                Float

  district District   @relation(fields: [districtId], references: [id])
  keeps    Keep[]
  traits   PlotTrait[]

  @@index([districtId])
}

model PlotTrait {
  id        String @id @default(cuid())
  plotId    String
  traitType String
  baseValue Float

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@unique([plotId, traitType])
  @@index([plotId])
}

// ── Warehouse ──────────────────────────────────────────────────────────────

// Universal storage container. Every Keep, Caravan, and empire×region exchange
// slot is backed by exactly one Warehouse row. Capacity is stored and updated
// transactionally when buildings or caravan animals change.
model Warehouse {
  id       String        @id @default(cuid())
  type     WarehouseType
  empireId String
  // Set only for EXCHANGE warehouses — identifies which region's exchange this is.
  regionId String?
  // Capacity in kg. Use 1e9 for effectively unlimited (exchange warehouses).
  cap      Float

  items   WarehouseItem[]
  empire  Empire          @relation(fields: [empireId], references: [id], onDelete: Cascade)
  keep    Keep?
  caravan Caravan?

  @@index([empireId])
  @@index([empireId, regionId])
}

// Single resource-type slot inside a Warehouse. Replaces ResourceLedger,
// CaravanCargo, and ExchangeStorage.
model WarehouseItem {
  id           String   @id @default(cuid())
  warehouseId  String
  resourceType String
  quantity     Float    @default(0)
  updatedAt    DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, resourceType])
  @@index([warehouseId])
}

// ── Player Economy ─────────────────────────────────────────────────────────

model Empire {
  id          String   @id @default(cuid())
  playerId    String   @unique
  name        String
  goldBalance Float    @default(0)
  createdAt   DateTime @default(now())

  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  keeps           Keep[]
  caravans        Caravan[]
  warehouses      Warehouse[]
  marketOrders    MarketOrder[]
  soldTrades      MarketTrade[] @relation("TradesSeller")
  purchasedTrades MarketTrade[] @relation("TradesBuyer")
}

model Keep {
  id                String   @id @default(cuid())
  empireId          String
  plotId            String
  name              String
  buildingSlotCount Int      @default(7)
  createdAt         DateTime @default(now())
  // Nullable during migration only — always set on keeps created after migration.
  warehouseId       String?  @unique

  empire           Empire           @relation(fields: [empireId], references: [id], onDelete: Cascade)
  plot             Plot             @relation(fields: [plotId], references: [id])
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id])
  buildings        Building[]
  productionOrders ProductionOrder[]
  productionTasks  ProductionTask[]

  @@index([empireId])
}

model Building {
  id                 String  @id @default(cuid())
  keepId             String
  buildingType       String
  level              Int     @default(1)
  slotIndex          Int
  isActive           Boolean @default(true)
  isDormant          Boolean @default(false)
  health             Float   @default(100)
  workersAssigned    Int     @default(0)
  productionProgress Float   @default(0)

  keep            Keep             @relation(fields: [keepId], references: [id], onDelete: Cascade)
  productionTask  ProductionTask?

  @@unique([keepId, slotIndex])
  @@index([keepId])
}

// ── Production Queue ───────────────────────────────────────────────────────

model ProductionOrder {
  id               String              @id @default(cuid())
  keepId           String
  buildingType     String
  recipeKey        String
  orderType        ProductionOrderType
  targetQuantity   Float?
  producedQuantity Float               @default(0)
  position         Int
  createdAt        DateTime            @default(now())

  keep Keep @relation(fields: [keepId], references: [id], onDelete: Cascade)

  @@index([keepId, buildingType, position])
}

// Tracks a single active production cycle for one building. Created when a
// production order is activated; deleted when the cycle completes. The server
// uses `completesAt` to schedule a timer instead of accumulating progress
// per-tick — clients derive live progress from `progressAtUpdate + elapsed`.
model ProductionTask {
  id               String   @id @default(cuid())
  buildingId       String   @unique
  keepId           String
  recipeKey        String
  startedAt        DateTime
  completesAt      DateTime
  progressAtUpdate Float    @default(0)
  updatedAt        DateTime @updatedAt
  speedSnapshot    Float    @default(1.0)

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  keep     Keep     @relation(fields: [keepId], references: [id], onDelete: Cascade)

  @@index([completesAt])
  @@index([keepId])
}

// ── Transport ──────────────────────────────────────────────────────────────

model Caravan {
  id          String              @id @default(cuid())
  empireId    String
  name        String              @default("Caravan")
  animalType  String              @default("MULE")
  animalCount Int                 @default(1)

  locationType CaravanLocationType
  locationId   String

  status    CaravanStatus        @default(IDLE)
  destType  CaravanLocationType?
  destId    String?
  departedAt DateTime?
  arrivesAt  DateTime?

  // Nullable during migration only — always set on caravans created after migration.
  warehouseId String?  @unique

  empire    Empire     @relation(fields: [empireId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([empireId])
  @@index([status, arrivesAt])
}

// ── Exchange ───────────────────────────────────────────────────────────────

model MarketOrder {
  id           String      @id @default(cuid())
  empireId     String?
  regionId     String
  orderType    OrderType
  resourceType String
  quantity     Float
  pricePerUnit Float
  fulfilledQty Float       @default(0)
  status       OrderStatus @default(OPEN)
  createdAt    DateTime    @default(now())

  empire Empire? @relation(fields: [empireId], references: [id], onDelete: SetNull)
  region Region  @relation(fields: [regionId], references: [id])
  trades MarketTrade[]

  @@index([regionId, resourceType, status])
  @@index([empireId])
}

model MarketTrade {
  id             String   @id @default(cuid())
  listingId      String
  sellerEmpireId String?
  buyerEmpireId  String
  resourceType   String
  quantity       Float
  pricePerUnit   Float
  totalGold      Float
  executedAt     DateTime @default(now())

  listing      MarketOrder @relation(fields: [listingId], references: [id])
  sellerEmpire Empire?     @relation("TradesSeller", fields: [sellerEmpireId], references: [id], onDelete: SetNull)
  buyerEmpire  Empire      @relation("TradesBuyer",  fields: [buyerEmpireId],  references: [id])

  @@index([listingId])
  @@index([buyerEmpireId])
  @@index([executedAt])
}

// ── Guilds ─────────────────────────────────────────────────────────────────

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  leaderId    String
  level       Int      @default(1)
  goldBalance Float    @default(0)
  createdAt   DateTime @default(now())

  leader           Player            @relation("GuildLeader", fields: [leaderId], references: [id])
  members          GuildMember[]
  districtControls DistrictControl[]
}

model GuildMember {
  id       String    @id @default(cuid())
  guildId  String
  playerId String    @unique
  role     GuildRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model DistrictControl {
  id           String   @id @default(cuid())
  guildId      String
  districtId   String
  weekNumber   Int
  controlStart DateTime
  controlEnd   DateTime

  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id])

  @@unique([districtId, weekNumber])
  @@index([guildId])
}

// ── Chat ───────────────────────────────────────────────────────────────────

model ChatMessage {
  id          String          @id @default(cuid())
  senderId    String
  channelType ChatChannelType
  channelId   String?
  content     String          @db.VarChar(500)
  sentAt      DateTime        @default(now())

  sender Player @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelType, channelId, sentAt])
}

// ── System ─────────────────────────────────────────────────────────────────

model GameTick {
  id          String   @id @default(cuid())
  tickNumber  Int      @unique
  processedAt DateTime
  durationMs  Int

  taxCollections TaxCollection[]
}

model TaxCollection {
  id            String   @id @default(cuid())
  regionId      String
  tickId        String
  totalAmount   Float
  guildShare    Float
  treasuryShare Float
  collectedAt   DateTime @default(now())

  region Region   @relation(fields: [regionId], references: [id])
  tick   GameTick @relation(fields: [tickId], references: [id])
}
