generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum WarehouseType {
  KEEP
  CARAVAN
  EXCHANGE
}

enum CaravanStatus {
  IDLE
  IN_TRANSIT
}

enum CaravanLocationType {
  KEEP
  EXCHANGE
  PLOT
}

enum WorkerTier {
  T1
  T2
  T3
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum ProductionOrderType {
  INFINITE
  NUMERICAL
}

enum GuildRole {
  LEADER
  OFFICER
  MEMBER
}

enum ChatChannelType {
  GLOBAL
  GUILD
  REGION
}

// ── Auth ───────────────────────────────────────────────────────────────────

model Player {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  empire        Empire?
  refreshTokens RefreshToken[]
  guildMember   GuildMember?
  chatMessages  ChatMessage[]
  ledsGuilds    Guild[]        @relation("GuildLeader")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  playerId  Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ── World ──────────────────────────────────────────────────────────────────

// Region IDs are manually assigned in seed: 1=CENTRAL 2=NE 3=NW 4=SW 5=SE
// Use REGION_IDS from @merchant-realms/shared for all references.
model Region {
  id                Int     @id
  name              String
  guildControllable Boolean

  districts      District[]
  marketOrders   MarketOrder[]
  taxCollections TaxCollection[]
}

model District {
  id               Int    @id @default(autoincrement())
  regionId         Int
  name             String
  bonusDescription String
  tier             Int    @default(1)
  q                Int
  r                Int
  x                Float
  y                Float

  region           Region            @relation(fields: [regionId], references: [id])
  plots            Plot[]
  districtControls DistrictControl[]

  @@unique([q, r])
  @@index([regionId])
}

model Plot {
  id               Int     @id @default(autoincrement())
  districtId       Int
  name             String
  bonusDescription String
  tier             Int     @default(1)
  isCenter         Boolean @default(false)
  x                Float
  y                Float

  district District   @relation(fields: [districtId], references: [id])
  keeps    Keep[]
  traits   PlotTrait[]

  @@index([districtId])
}

model PlotTrait {
  id        Int    @id @default(autoincrement())
  plotId    Int
  traitType String
  baseValue Float

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@unique([plotId, traitType])
  @@index([plotId])
}

// ── Warehouse ──────────────────────────────────────────────────────────────

model Warehouse {
  id       Int           @id @default(autoincrement())
  type     WarehouseType
  empireId Int
  // Set only for EXCHANGE warehouses — identifies which region's exchange this is.
  regionId Int?
  // Capacity in kg. Use 1e9 for effectively unlimited (exchange warehouses).
  cap      Float

  items   WarehouseItem[]
  empire  Empire          @relation(fields: [empireId], references: [id], onDelete: Cascade)
  keep    Keep?
  caravan Caravan?

  @@index([empireId])
  @@index([empireId, regionId])
}

model WarehouseItem {
  id           Int      @id @default(autoincrement())
  warehouseId  Int
  resourceType String
  quantity     Float    @default(0)
  updatedAt    DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, resourceType])
  @@index([warehouseId])
}

// ── Player Economy ─────────────────────────────────────────────────────────

model Empire {
  id          Int      @id @default(autoincrement())
  playerId    Int      @unique
  name        String
  goldBalance Float    @default(0)
  createdAt   DateTime @default(now())

  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  keeps           Keep[]
  caravans        Caravan[]
  warehouses      Warehouse[]
  marketOrders    MarketOrder[]
  soldTrades      MarketTrade[] @relation("TradesSeller")
  purchasedTrades MarketTrade[] @relation("TradesBuyer")
  wishlists       Wishlist[]
}

// ── Wishlists ──────────────────────────────────────────────────────────────

model Wishlist {
  id        Int            @id @default(autoincrement())
  empireId  Int
  name      String
  createdAt DateTime       @default(now())

  empire Empire         @relation(fields: [empireId], references: [id], onDelete: Cascade)
  items  WishlistItem[]

  @@index([empireId])
}

model WishlistItem {
  id           Int      @id @default(autoincrement())
  wishlistId   Int
  resourceType String
  quantity     Int

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, resourceType])
  @@index([wishlistId])
}

model Keep {
  id                Int      @id @default(autoincrement())
  empireId          Int
  plotId            Int
  name              String
  buildingSlotCount Int      @default(6)
  createdAt         DateTime @default(now())
  // Nullable during migration only — always set on keeps created after migration.
  warehouseId       Int?     @unique

  empire           Empire           @relation(fields: [empireId], references: [id], onDelete: Cascade)
  plot             Plot             @relation(fields: [plotId], references: [id])
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id])
  buildings        Building[]
  productionOrders ProductionOrder[]
  productionTasks  ProductionTask[]

  @@index([empireId])
}

model Building {
  id                 Int     @id @default(autoincrement())
  keepId             Int
  buildingTypeId     Int
  level              Int     @default(1)
  slotIndex          Int
  isActive           Boolean @default(true)
  isDormant          Boolean @default(false)
  health             Float   @default(100)
  workersAssigned    Int     @default(0)

  keep            Keep             @relation(fields: [keepId], references: [id], onDelete: Cascade)
  productionTask  ProductionTask?

  @@unique([keepId, slotIndex])
  @@index([keepId])
  @@index([buildingTypeId])
}

// ── Production Queue ───────────────────────────────────────────────────────

model ProductionOrder {
  id               Int                 @id @default(autoincrement())
  keepId           Int
  buildingTypeId   Int
  recipeId         Int
  orderType        ProductionOrderType
  targetQuantity   Float?
  producedQuantity Float               @default(0)
  position         Int
  createdAt        DateTime            @default(now())

  keep Keep @relation(fields: [keepId], references: [id], onDelete: Cascade)

  @@index([keepId, buildingTypeId, position])
}

model ProductionTask {
  id               Int      @id @default(autoincrement())
  buildingId       Int      @unique
  keepId           Int
  recipeId         Int
  startedAt        DateTime
  completesAt      DateTime
  progressAtUpdate Float    @default(0)
  updatedAt        DateTime @updatedAt
  speedSnapshot    Float    @default(1.0)

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  keep     Keep     @relation(fields: [keepId], references: [id], onDelete: Cascade)

  @@index([completesAt])
  @@index([keepId])
}

// ── Transport ──────────────────────────────────────────────────────────────

model Caravan {
  id          Int                 @id @default(autoincrement())
  empireId    Int
  name        String              @default("Caravan")
  animalType  String              @default("MULE")
  animalCount Int                 @default(1)

  locationType CaravanLocationType
  locationId   Int

  status    CaravanStatus        @default(IDLE)
  destType  CaravanLocationType?
  destId    Int?
  departedAt DateTime?
  arrivesAt  DateTime?

  // Nullable during migration only — always set on caravans created after migration.
  warehouseId Int?  @unique

  empire    Empire     @relation(fields: [empireId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([empireId])
  @@index([status, arrivesAt])
}

// ── Exchange ───────────────────────────────────────────────────────────────

model MarketOrder {
  id           Int         @id @default(autoincrement())
  empireId     Int?
  regionId     Int
  orderType    OrderType
  resourceType String
  quantity     Float
  pricePerUnit Float
  fulfilledQty Float       @default(0)
  status       OrderStatus @default(OPEN)
  createdAt    DateTime    @default(now())

  empire Empire? @relation(fields: [empireId], references: [id], onDelete: SetNull)
  region Region  @relation(fields: [regionId], references: [id])
  trades MarketTrade[]

  @@index([regionId, resourceType, status])
  @@index([empireId])
}

model MarketTrade {
  id             Int      @id @default(autoincrement())
  listingId      Int
  sellerEmpireId Int?
  buyerEmpireId  Int
  resourceType   String
  quantity       Float
  pricePerUnit   Float
  totalGold      Float
  executedAt     DateTime @default(now())

  listing      MarketOrder @relation(fields: [listingId], references: [id])
  sellerEmpire Empire?     @relation("TradesSeller", fields: [sellerEmpireId], references: [id], onDelete: SetNull)
  buyerEmpire  Empire      @relation("TradesBuyer",  fields: [buyerEmpireId],  references: [id])

  @@index([listingId])
  @@index([buyerEmpireId])
  @@index([executedAt])
}

// ── Guilds ─────────────────────────────────────────────────────────────────

model Guild {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  leaderId    Int
  level       Int      @default(1)
  goldBalance Float    @default(0)
  createdAt   DateTime @default(now())

  leader           Player            @relation("GuildLeader", fields: [leaderId], references: [id])
  members          GuildMember[]
  districtControls DistrictControl[]
}

model GuildMember {
  id       Int       @id @default(autoincrement())
  guildId  Int
  playerId Int       @unique
  role     GuildRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model DistrictControl {
  id           Int      @id @default(autoincrement())
  guildId      Int
  districtId   Int
  weekNumber   Int
  controlStart DateTime
  controlEnd   DateTime

  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id])

  @@unique([districtId, weekNumber])
  @@index([guildId])
}

// ── Chat ───────────────────────────────────────────────────────────────────

model ChatMessage {
  id          Int             @id @default(autoincrement())
  senderId    Int
  channelType ChatChannelType
  channelId   Int?
  content     String          @db.VarChar(500)
  sentAt      DateTime        @default(now())

  sender Player @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelType, channelId, sentAt])
}

// ── System ─────────────────────────────────────────────────────────────────

model GameTick {
  id          Int      @id @default(autoincrement())
  tickNumber  Int      @unique
  processedAt DateTime
  durationMs  Int

  taxCollections TaxCollection[]
}

model TaxCollection {
  id            Int      @id @default(autoincrement())
  regionId      Int
  tickId        Int
  totalAmount   Float
  guildShare    Float
  treasuryShare Float
  collectedAt   DateTime @default(now())

  region Region   @relation(fields: [regionId], references: [id])
  tick   GameTick @relation(fields: [tickId], references: [id])
}
