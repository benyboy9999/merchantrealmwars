generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum CaravanStatus {
  IDLE
  IN_TRANSIT
}

enum CaravanLocationType {
  KEEP
  EXCHANGE
  PLOT
}

enum WorkerTier {
  T1
  T2
  T3
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum ProductionOrderType {
  INFINITE
  NUMERICAL
}

enum GuildRole {
  LEADER
  OFFICER
  MEMBER
}

enum ChatChannelType {
  GLOBAL
  GUILD
  REGION
}

// ── Auth ───────────────────────────────────────────────────────────────────

model Player {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  empire        Empire?
  refreshTokens RefreshToken[]
  guildMember   GuildMember?
  chatMessages  ChatMessage[]
  ledsGuilds    Guild[]        @relation("GuildLeader")
}

model RefreshToken {
  id        String   @id @default(cuid())
  playerId  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ── World ──────────────────────────────────────────────────────────────────

model Region {
  id                String  @id
  name              String
  guildControllable Boolean

  districts      District[]
  bonuses        RegionBonus[]
  marketOrders   MarketOrder[]
  taxCollections TaxCollection[]
}

// Blanket production bonus a region applies to a resource category.
// category is a string key (e.g. "IRON_EXTRACTION") — enum deferred until item chains finalised.
model RegionBonus {
  id        String @id @default(cuid())
  regionId  String
  category  String // resource category this bonus applies to
  magnitude Float  // additive multiplier, e.g. 0.15 = +15%

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, category])
  @@index([regionId])
}

// A named hex tile on the visual map. Contains 4–6 Plots.
model District {
  id               String @id
  regionId         String
  name             String
  bonusDescription String
  tier             Int    @default(1) // 1–3; multiplies plot trait values within this district
  q                Int    // hex axial q coordinate
  r                Int    // hex axial r coordinate
  x                Float  // absolute map x (1000x1000 grid, center = 500,500)
  y                Float  // absolute map y

  region           Region           @relation(fields: [regionId], references: [id])
  plots            Plot[]
  districtControls DistrictControl[]

  @@unique([q, r])
  @@index([regionId])
}

// An individual buildable location within a District where a Keep can be founded.
model Plot {
  id               String @id
  districtId       String
  name             String
  bonusDescription String
  tier             Int    @default(1) // 1–4; determines resource quality ceiling and permit build cost
  x                Float  // absolute map x coordinate
  y                Float  // absolute map y coordinate

  district District   @relation(fields: [districtId], references: [id])
  keeps    Keep[]
  traits   PlotTrait[]

  @@index([districtId])
}

// A single trait on a plot (e.g. iron abundance, construction speed bonus).
// traitType is a string key — enum deferred until item chains finalised.
model PlotTrait {
  id        String @id @default(cuid())
  plotId    String
  traitType String // e.g. "IRON_ABUNDANCE", "FERTILITY", "CONSTRUCTION_SPEED"
  baseValue Float  // raw value before district tier multiplier is applied

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@unique([plotId, traitType])
  @@index([plotId])
}

// ── Player Economy ─────────────────────────────────────────────────────────

model Empire {
  id          String   @id @default(cuid())
  playerId    String   @unique
  name        String
  goldBalance Float    @default(0)
  createdAt   DateTime @default(now())

  player            Player                 @relation(fields: [playerId], references: [id], onDelete: Cascade)
  keeps             Keep[]
  caravans          Caravan[]
  exchangeStorages  ExchangeStorage[]
  marketOrders      MarketOrder[]
  soldTrades        MarketTrade[]          @relation("TradesSeller")
  purchasedTrades   MarketTrade[]          @relation("TradesBuyer")
  consumptionLogs   WorkerConsumptionLog[]
  specialisations   EmpireSpecialisation[]
}

model Keep {
  id                String   @id @default(cuid())
  empireId          String
  plotId            String
  name              String
  buildingSlotCount Int      @default(7)
  createdAt         DateTime @default(now())

  empire         Empire           @relation(fields: [empireId], references: [id], onDelete: Cascade)
  plot           Plot             @relation(fields: [plotId], references: [id])
  buildings      Building[]
  resourceLedger ResourceLedger[]
  upkeepLogs     BuildingUpkeepLog[]
  productionOrders ProductionOrder[]

  @@index([empireId])
}

model Building {
  id               String  @id @default(cuid())
  keepId           String
  buildingType     String  // BuildingType enum value
  level            Int     @default(1)
  slotIndex        Int
  isActive            Boolean @default(true)
  isDormant           Boolean @default(false)
  health              Float   @default(100)
  workersAssigned     Int     @default(0)
  productionProgress  Float   @default(0)

  keep       Keep                @relation(fields: [keepId], references: [id], onDelete: Cascade)
  upkeepLogs BuildingUpkeepLog[]

  @@unique([keepId, slotIndex])
  @@index([keepId])
}

model ResourceLedger {
  id           String   @id @default(cuid())
  keepId       String
  resourceType String   // ResourceType enum value
  quantity     Float    @default(0)
  updatedAt    DateTime @updatedAt

  keep Keep @relation(fields: [keepId], references: [id], onDelete: Cascade)

  @@unique([keepId, resourceType])
}

// ── Production Queue ───────────────────────────────────────────────────────

model ProductionOrder {
  id               String              @id @default(cuid())
  keepId           String
  buildingType     String              // which building type's queue this belongs to
  recipeKey        String              // matches Recipe.key in engine
  orderType        ProductionOrderType
  targetQuantity   Float?              // NUMERICAL only
  producedQuantity Float               @default(0)
  position         Int                 // lower = earlier in queue
  createdAt        DateTime            @default(now())

  keep Keep @relation(fields: [keepId], references: [id], onDelete: Cascade)

  @@index([keepId, buildingType, position])
}

// ── Workers ────────────────────────────────────────────────────────────────

model WorkerConsumptionLog {
  id             String   @id @default(cuid())
  empireId       String
  tickId         String
  resourceType   String
  required       Float
  actual         Float
  penaltyApplied Float

  empire Empire   @relation(fields: [empireId], references: [id], onDelete: Cascade)
  tick   GameTick @relation(fields: [tickId], references: [id])

  @@index([empireId, tickId])
}

// ── Transport ──────────────────────────────────────────────────────────────

// A persistent caravan vehicle owned by an empire. It lives at a location,
// carries cargo, and travels between keeps, the exchange, and empty plots.
model Caravan {
  id           String               @id @default(cuid())
  empireId     String
  name         String               @default("Caravan")
  animalType   String               @default("MULE")
  animalCount  Int                  @default(1)

  // Current location (when IDLE) or departure point (when IN_TRANSIT)
  locationType CaravanLocationType
  locationId   String

  // Travel state (null when IDLE)
  status       CaravanStatus        @default(IDLE)
  destType     CaravanLocationType?
  destId       String?
  departedAt   DateTime?
  arrivesAt    DateTime?

  cargo  CaravanCargo[]
  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@index([empireId])
  @@index([status, arrivesAt])
}

// Items currently loaded onto a caravan
model CaravanCargo {
  id           String @id @default(cuid())
  caravanId    String
  resourceType String
  quantity     Float

  caravan Caravan @relation(fields: [caravanId], references: [id], onDelete: Cascade)

  @@unique([caravanId, resourceType])
  @@index([caravanId])
}

// Player's inventory held at an exchange (deposited by caravan, listed for sale)
model ExchangeStorage {
  id           String @id @default(cuid())
  empireId     String
  regionId     String
  resourceType String
  quantity     Float  @default(0)

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, regionId, resourceType])
  @@index([empireId])
}

// ── Exchange ───────────────────────────────────────────────────────────────

model MarketOrder {
  id           String      @id @default(cuid())
  empireId     String?     // null = NPC order
  regionId     String
  orderType    OrderType
  resourceType String
  quantity     Float
  pricePerUnit Float
  fulfilledQty Float       @default(0)
  status       OrderStatus @default(OPEN)
  createdAt    DateTime    @default(now())

  empire Empire? @relation(fields: [empireId], references: [id], onDelete: SetNull)
  region Region  @relation(fields: [regionId], references: [id])
  trades MarketTrade[]

  @@index([regionId, resourceType, status])
  @@index([empireId])
}

model MarketTrade {
  id             String   @id @default(cuid())
  listingId      String
  sellerEmpireId String?
  buyerEmpireId  String
  resourceType   String
  quantity       Float
  pricePerUnit   Float
  totalGold      Float
  executedAt     DateTime @default(now())

  listing      MarketOrder @relation(fields: [listingId], references: [id])
  sellerEmpire Empire?     @relation("TradesSeller", fields: [sellerEmpireId], references: [id], onDelete: SetNull)
  buyerEmpire  Empire      @relation("TradesBuyer",  fields: [buyerEmpireId],  references: [id])

  @@index([listingId])
  @@index([buyerEmpireId])
  @@index([executedAt])
}

// ── Guilds ─────────────────────────────────────────────────────────────────

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  leaderId    String
  level       Int      @default(1)
  goldBalance Float    @default(0)
  createdAt   DateTime @default(now())

  leader           Player            @relation("GuildLeader", fields: [leaderId], references: [id])
  members          GuildMember[]
  districtControls DistrictControl[]
}

model GuildMember {
  id       String    @id @default(cuid())
  guildId  String
  playerId String    @unique
  role     GuildRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// Guild control of an individual contestable district.
// Winning guild gets the abundance tier bonus for that district's zone (Inner +1, Outer +2).
// Tax share is computed per-tick from how many districts a guild controls in each region.
model DistrictControl {
  id           String   @id @default(cuid())
  guildId      String
  districtId   String
  weekNumber   Int
  controlStart DateTime
  controlEnd   DateTime

  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id])

  @@unique([districtId, weekNumber])
  @@index([guildId])
}

// ── Specialisation ─────────────────────────────────────────────────────────

model SpecialisationTree {
  id          String @id @default(cuid())
  name        String @unique
  description String
  nodes       SpecialisationNode[]
}

model SpecialisationNode {
  id               String @id @default(cuid())
  treeId           String
  level            Int
  bonusDescription String
  recipeUnlocks    Json   @default("[]")
  cost             Json

  tree               SpecialisationTree     @relation(fields: [treeId], references: [id])
  empireAcquisitions EmpireSpecialisation[]

  @@unique([treeId, level])
}

model EmpireSpecialisation {
  id         String   @id @default(cuid())
  empireId   String
  nodeId     String
  acquiredAt DateTime @default(now())

  empire Empire             @relation(fields: [empireId], references: [id], onDelete: Cascade)
  node   SpecialisationNode @relation(fields: [nodeId], references: [id])

  @@unique([empireId, nodeId])
}

// ── Chat ───────────────────────────────────────────────────────────────────

model ChatMessage {
  id          String          @id @default(cuid())
  senderId    String
  channelType ChatChannelType
  channelId   String?
  content     String          @db.VarChar(500)
  sentAt      DateTime        @default(now())

  sender Player @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelType, channelId, sentAt])
}

// ── System ─────────────────────────────────────────────────────────────────

model GameTick {
  id          String   @id @default(cuid())
  tickNumber  Int      @unique
  processedAt DateTime
  durationMs  Int

  consumptionLogs WorkerConsumptionLog[]
  taxCollections  TaxCollection[]
}

model TaxCollection {
  id            String   @id @default(cuid())
  regionId      String
  tickId        String
  totalAmount   Float
  guildShare    Float
  treasuryShare Float
  collectedAt   DateTime @default(now())

  region Region   @relation(fields: [regionId], references: [id])
  tick   GameTick @relation(fields: [tickId], references: [id])
}

model BuildingUpkeepLog {
  id         String   @id @default(cuid())
  buildingId String
  keepId     String
  tickId     String
  required   Json
  actual     Json
  isDormant  Boolean

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  keep     Keep     @relation(fields: [keepId], references: [id], onDelete: Cascade)

  @@index([buildingId])
}
